# ═══════════════════════════════════════════════════════════════
# Lumiere Booking System - Environment Variables Template
# ═══════════════════════════════════════════════════════════════
# 
# INSTRUCTIONS:
# 1. Copy this file and rename to ".env"
# 2. Fill in all values with your actual credentials
# 3. NEVER commit .env file to git (already in .gitignore)
# 
# ═══════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────
# DATABASE (Neon PostgreSQL)
# ────────────────────────────────────────────────────────────────
# Get from: https://neon.tech
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://username:password@ep-xxx-xxx.region.neon.tech/neondb?sslmode=require"

# ────────────────────────────────────────────────────────────────
# REDIS CACHE (Upstash)
# ────────────────────────────────────────────────────────────────
# Get from: https://upstash.com
UPSTASH_REDIS_URL="https://xxx-xxx-xxx.upstash.io"
UPSTASH_REDIS_TOKEN="AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ────────────────────────────────────────────────────────────────
# EMAIL SERVICE (Resend)
# ────────────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Lumiere <noreply@yourdomain.com>"

# ────────────────────────────────────────────────────────────────
# IMAGE STORAGE (Cloudinary)
# ────────────────────────────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ────────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# ────────────────────────────────────────────────────────────────
# Generate a strong random secret (min 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# ────────────────────────────────────────────────────────────────
# APPLICATION URLS
# ────────────────────────────────────────────────────────────────
# Backend server port (default: 3001)
PORT=3001

# Frontend URL (for CORS and email links)
# Development: http://localhost:5173
# Production: https://yourdomain.vercel.app
FRONTEND_URL="http://localhost:5173"

# ────────────────────────────────────────────────────────────────
# ENVIRONMENT
# ────────────────────────────────────────────────────────────────
# Set to "production" when deploying
NODE_ENV="development"

# ────────────────────────────────────────────────────────────────
# FRONTEND ENV (Vite variables - prefix with VITE_)
# ────────────────────────────────────────────────────────────────
# API endpoint URL
# Development: http://localhost:3001/api
# Production: https://yourdomain.vercel.app/api
VITE_API_URL="http://localhost:3001/api"

# ═══════════════════════════════════════════════════════════════
# NOTES:
# ═══════════════════════════════════════════════════════════════
#
# 1. DATABASE SETUP:
#    - Sign up at neon.tech (free tier: 500MB)
#    - Create new project
#    - Copy connection string with ?sslmode=require
#
# 2. REDIS SETUP:
#    - Sign up at upstash.com (free tier: 10k requests/day)
#    - Create Redis database
#    - Copy both URL and TOKEN
#
# 3. EMAIL SETUP:
#    - Sign up at resend.com (free tier: 3k emails/month)
#    - Create API key
#    - Optionally verify your domain for branded emails
#
# 4. CLOUDINARY SETUP:
#    - Sign up at cloudinary.com (free tier: 25GB/month)
#    - Copy Cloud Name, API Key, and API Secret from dashboard
#
# 5. JWT SECRET:
#    - Generate strong random string: openssl rand -base64 32
#    - Keep this secret! Never expose in public repos
#
# 6. FOR PRODUCTION (Vercel):
#    - Add all these variables in Vercel Dashboard
#    - Go to: Project Settings → Environment Variables
#    - Update FRONTEND_URL to your Vercel domain
#    - Update VITE_API_URL to your Vercel domain + /api
#
# ═══════════════════════════════════════════════════════════════
