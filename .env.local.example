# ═══════════════════════════════════════════════════════════════
# Frontend Environment Variables (Vite)
# ═══════════════════════════════════════════════════════════════
# 
# INSTRUCTIONS:
# 1. Copy this file and rename to ".env.local"
# 2. This file is for Vite frontend variables only
# 3. All Vite variables must start with VITE_
# 
# ═══════════════════════════════════════════════════════════════

# Backend API URL
VITE_API_URL="http://localhost:3001/api"

# ═══════════════════════════════════════════════════════════════
# PRODUCTION VALUES:
# ═══════════════════════════════════════════════════════════════
# VITE_API_URL="https://yourdomain.vercel.app/api"
